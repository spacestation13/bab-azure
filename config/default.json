{
  "server": {
    "host": "::1",
    "port": "80",
    "publicUrl": "",
    // Follows the format at https://expressjs.com/en/4x/api.html#trust.proxy.options.table minus the functions
    "proxy": false
  },
  "database": {
    "connectionString": ""
  },
  "logging": {
    /* Sources */


    "http": {
      // 1xx-3xx are info, 4xx is always warning, 5xx is always error
      "level": "info",
      // Can spam logs quickly
      "meta": false
    },


    /* Sinks */


    "console": {
      "level": "info",
      "enabled": true,
      // Has performance impact. Ignored when logging.console.json is true
      "pretty": false,
      // Functions/App Insights expects JSON
      "json": true
    }
  },
  // Changing any of these in production is heavily discouraged. You will probably violate an RFC and reduce security.
  "security": {
    "test": false,
    "enforce_redirect_uri": true
  }
}
